<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: the GitHub artifact "windows-unsigned"
     (a zip with the PyInstaller executable) gets an Authenticode signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="openwisp-voucher.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
